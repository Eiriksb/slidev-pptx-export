{
  "name": "slidev-pptx-export",
  "version": "0.4.0",
  "description": "Convert a Slidev markdown deck into a fully editable native .pptx - real PowerPoint text boxes, tables, shapes and charts, not a screenshot-per-slide export.",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "slidev-pptx-export": "bin/cli.mjs"
  },
  "files": [
    "src",
    "bin"
  ],
  "keywords": [
    "slidev",
    "pptx",
    "powerpoint",
    "markdown",
    "presentation",
    "export"
  ],
  "license": "MIT",
  "author": "Eirik B.",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eiriksb/slidev-pptx-export.git"
  },
  "bugs": {
    "url": "https://github.com/Eiriksb/slidev-pptx-export/issues"
  },
  "homepage": "https://github.com/Eiriksb/slidev-pptx-export#readme",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:render": "node --test test/render/*.test.mjs",
    "render": "node scripts/render.mjs"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "playwright-chromium": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": { "optional": true },
    "playwright-chromium": { "optional": true }
  },
  "dependencies": {
    "image-size": "^2.0.4",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "chart.js": "^4.5.1",
    "playwright-chromium": "^1.64.1"
  }
}
